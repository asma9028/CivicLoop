generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CITIZEN
  AUTHORITY
  ADMIN
}

enum IncidentStatus {
  REPORTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLUTION_SUBMITTED
  VERIFICATION_PENDING
  RESOLVED
  REOPENED
  ON_HOLD
  REJECTED
  DUPLICATE
}

enum IncidentCategory {
  ROAD
  WASTE
  WATER
  DRAINAGE
  ELECTRICITY
  PUBLIC_SPACE
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PriorityBand {
  P1
  P2
  P3
  P4
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum AIAnalysisStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum VerificationResult {
  LIKELY_RESOLVED
  LIKELY_UNRESOLVED
  UNCERTAIN
  MISMATCH
  PENDING
}

enum VerificationCaseStatus {
  PENDING
  DISPUTED
  REVIEW_REQUIRED
  VERIFIED
  REOPENED
}

enum VerificationDecision {
  CONFIRM
  ISSUE_REMAINS
  INCOMPLETE
  EVIDENCE_MISMATCH
  REQUEST_FURTHER_ACTION
}

enum VerificationActionType {
  CITIZEN_CONFIRMED
  CITIZEN_DISPUTED
  CITIZEN_EVIDENCE_SUBMITTED
  REVIEW_ASSIGNED
  REVIEW_CONFIRMED
  REVIEW_REOPENED
  REVIEW_REQUESTED_EVIDENCE
  DEADLINE_ESCALATED
  AI_ANALYZED
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  DISMISSED
  IN_PROGRESS
  COMPLETED
}

enum SupportEventAction {
  SUPPORTED
  UNSUPPORTED
}

enum CivicCampaignType {
  AWARENESS
  CLEANUP
  INFRASTRUCTURE
  SAFETY
  CONSERVATION
  OTHER
}

enum CivicCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignAuditAction {
  CREATED
  UPDATED
  PUBLISHED
  PAUSED
  RESUMED
  COMPLETED
  CANCELLED
  INCIDENT_LINKED
  INCIDENT_UNLINKED
}

enum CivicNotificationType {
  SUPPORTED_INCIDENT_UPDATE
  FOLLOWED_AREA_ACTIVITY
  CAMPAIGN_UPDATE
  VERIFIED_IMPROVEMENT
}

enum CampaignParticipationAction {
  JOINED
  LEFT
}

enum FeedbackType {
  CONFIRMED_RESOLVED
  NOT_RESOLVED
  STILL_PRESENT
  OTHER
}

enum ActivityType {
  STATUS_CHANGED
  DEPARTMENT_ASSIGNED
  AUTHORITY_ASSIGNED
  AUTHORITY_UNASSIGNED
  EVIDENCE_SUBMITTED
  FEEDBACK_SUBMITTED
  OPERATIONAL_UPDATE
  INTERNAL_NOTE
  RESOLUTION_SUBMITTED
  INCIDENT_REJECTED
  INCIDENT_DUPLICATED
  VERIFICATION_REQUESTED
  VERIFICATION_CONFIRMED
  VERIFICATION_DISPUTED
  VERIFICATION_REVIEWED
  ADMIN_ACTION
  OTHER
}

enum ActivityVisibility {
  PUBLIC
  INTERNAL
}

enum AuditAction {
  ROLE_CHANGED
  ACCOUNT_ACTIVATED
  ACCOUNT_SUSPENDED
  ACCOUNT_INACTIVATED
  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  AUTHORITY_PROVISIONED
  PROFILE_UPDATED
  UPLOAD_CLEANUP
}

model User {
  id                        String                  @id @default(cuid())
  fullName                  String
  email                     String                  @unique
  passwordHash              String
  phoneNumber               String?
  role                      UserRole                @default(CITIZEN)
  accountStatus             AccountStatus           @default(ACTIVE)
  authority                 AuthorityProfile?
  incidents                 Incident[]              @relation("IncidentReporter")
  incidentUploads           IncidentUpload[]
  assignedIncidents         Incident[]              @relation("IncidentAuthority")
  incidentActivities        IncidentActivity[]      @relation("ActivityActor")
  resolutionEvidence        ResolutionEvidence[]    @relation("EvidenceSubmitter")
  verificationCasesReported VerificationCase[]      @relation("VerificationReporter")
  verificationCasesAssigned VerificationCase[]      @relation("VerificationReviewer")
  verificationActions       VerificationAction[]
  recommendationHistory     RecommendationHistory[]
  feedback                  CitizenFeedback[]       @relation("CitizenFeedback")
  incidentSupports          IncidentSupport[]
  incidentSupportEvents     IncidentSupportEvent[]
  followedAreas             FollowedArea[]
  createdCivicCampaigns     CivicCampaign[]         @relation("CampaignCreator")
  campaignParticipation     CampaignParticipant[]
  campaignIncidentLinks     CampaignIncident[]      @relation("CampaignIncidentLinker")
  campaignAuditEvents       CampaignAuditEvent[]    @relation("CampaignAuditActor")
  civicNotifications        CivicNotification[]
  auditEvents               AuditLog[]              @relation("AuditActor")
  aiConsentGrants           AiConsentGrant[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
}

model Department {
  id              String                    @id @default(cuid())
  name            String                    @unique
  code            String                    @unique
  description     String                    @default("")
  contactEmail    String?
  contactPhone    String?
  status          DepartmentStatus          @default(ACTIVE)
  authorities     AuthorityProfile[]
  incidents       Incident[]
  recommendations ProactiveRecommendation[] @relation("RecommendationDepartment")
  civicCampaigns  CivicCampaign[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
}

model AuthorityProfile {
  id                 String     @id @default(cuid())
  userId             String     @unique
  departmentId       String
  designation        String
  employeeIdentifier String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department         Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Incident {
  id                    String                 @id @default(cuid())
  title                 String
  description           String
  category              IncidentCategory
  subcategory           String?
  locationText          String
  latitude              Float
  longitude             Float
  imageUrls             String[]
  reporterId            String?
  departmentId          String?
  assignedAuthorityId   String?
  severity              Severity               @default(MEDIUM)
  priorityScore         Int                    @default(0)
  priorityBand          PriorityBand           @default(P3)
  priorityBreakdown     Json?
  status                IncidentStatus         @default(REPORTED)
  acknowledgedAt        DateTime?
  assignedAt            DateTime?
  resolutionSubmittedAt DateTime?
  holdReason            String?
  rejectionReason       String?
  isPublic              Boolean                @default(true)
  duplicateOfIncidentId String?
  aiSummary             String?
  aiAnalysisStatus      AIAnalysisStatus       @default(PENDING)
  aiCategory            IncidentCategory?
  aiSubcategory         String?
  aiConfidence          Float?
  aiReasoning           String?
  aiProvider            String?
  resolutionDescription String?
  reporter              User?                  @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  department            Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedAuthority     User?                  @relation("IncidentAuthority", fields: [assignedAuthorityId], references: [id], onDelete: SetNull)
  duplicateOf           Incident?              @relation("IncidentDuplicate", fields: [duplicateOfIncidentId], references: [id], onDelete: SetNull)
  duplicates            Incident[]             @relation("IncidentDuplicate")
  activities            IncidentActivity[]
  evidence              ResolutionEvidence[]
  uploads               IncidentUpload[]
  feedback              CitizenFeedback[]
  verificationCases     VerificationCase[]
  supporters            IncidentSupport[]
  supportEvents         IncidentSupportEvent[]
  campaignLinks         CampaignIncident[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  resolvedAt            DateTime?

  @@index([reporterId, createdAt])
  @@index([isPublic, status, createdAt])
  @@index([category, createdAt])
  @@index([latitude, longitude, createdAt])
  @@index([departmentId, status, priorityScore])
  @@index([departmentId, createdAt])
  @@index([assignedAuthorityId, status, createdAt])
  @@index([status, updatedAt])
}

model IncidentUpload {
  id               String    @id @default(cuid())
  storedName       String    @unique
  contentType      String
  uploadedByUserId String
  incidentId       String?
  isPublic         Boolean   @default(true)
  uploadedBy       User      @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  incident         Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())

  @@index([uploadedByUserId, incidentId])
}

model IncidentActivity {
  id                  String             @id @default(cuid())
  incidentId          String
  actorUserId         String?
  activityType        ActivityType       @default(OTHER)
  activityDescription String
  previousStatus      IncidentStatus?
  newStatus           IncidentStatus?
  visibility          ActivityVisibility @default(PUBLIC)
  metadata            Json?
  incident            Incident           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor               User?              @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())

  @@index([incidentId, createdAt])
  @@index([visibility, createdAt])
}

model ResolutionEvidence {
  id                  String             @id @default(cuid())
  incidentId          String
  submittedByUserId   String?
  evidenceImageUrls   String[]
  evidenceDescription String
  workCompleted       String?
  resolutionDate      DateTime?
  internalNotes       String?
  verificationResult  VerificationResult @default(PENDING)
  verificationNotes   String?
  incident            Incident           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  submittedBy         User?              @relation("EvidenceSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  submittedAt         DateTime           @default(now())
  verifiedAt          DateTime?
  verificationCase    VerificationCase?
}

model VerificationCase {
  id                   String                 @id @default(cuid())
  incidentId           String
  resolutionEvidenceId String                 @unique
  reporterId           String?
  assignedReviewerId   String?
  status               VerificationCaseStatus @default(PENDING)
  citizenDecision      VerificationDecision?
  citizenRespondedAt   DateTime?
  responseDeadline     DateTime
  escalationAt         DateTime?
  reviewDueAt          DateTime?
  incident             Incident               @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  resolutionEvidence   ResolutionEvidence     @relation(fields: [resolutionEvidenceId], references: [id], onDelete: Cascade)
  reporter             User?                  @relation("VerificationReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignedReviewer     User?                  @relation("VerificationReviewer", fields: [assignedReviewerId], references: [id], onDelete: SetNull)
  actions              VerificationAction[]
  analyses             VerificationAnalysis[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([status, responseDeadline])
  @@index([status, reviewDueAt])
  @@index([incidentId, createdAt])
  @@index([reporterId, status, responseDeadline])
  @@index([assignedReviewerId, status, reviewDueAt])
}

model VerificationAction {
  id               String                 @id @default(cuid())
  caseId           String
  actorUserId      String?
  actionType       VerificationActionType
  reason           String?
  evidenceUrls     String[]               @default([])
  isPublic         Boolean                @default(false)
  metadata         Json?
  verificationCase VerificationCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor            User?                  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime               @default(now())

  @@index([caseId, createdAt])
  @@index([actorUserId, createdAt])
}

model VerificationAnalysis {
  id                       String             @id @default(cuid())
  caseId                   String
  result                   VerificationResult
  confidence               Int
  evidenceRelevance        Int
  apparentImprovement      String
  evidenceQuality          String
  potentialInconsistencies String[]
  explanation              String
  recommendedNextAction    String
  provider                 String
  model                    String?
  contextHash              String
  verificationCase         VerificationCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt                DateTime           @default(now())

  @@index([caseId, createdAt])
}

model ProactiveRecommendation {
  id                      String                  @id @default(cuid())
  recommendationKey       String                  @unique
  title                   String
  description             String
  areaLabel               String
  latitude                Float
  longitude               Float
  category                IncidentCategory?
  riskScore               Int
  priority                RecommendationPriority
  status                  RecommendationStatus    @default(PENDING)
  supportingMetrics       Json
  recommendedAction       String
  responsibleDepartmentId String?
  dismissalReason         String?
  actionSummary           String?
  generatedAt             DateTime                @default(now())
  responsibleDepartment   Department?             @relation("RecommendationDepartment", fields: [responsibleDepartmentId], references: [id], onDelete: SetNull)
  history                 RecommendationHistory[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([responsibleDepartmentId, status, priority])
  @@index([status, priority, generatedAt])
  @@index([category, generatedAt])
}

model RecommendationHistory {
  id               String                  @id @default(cuid())
  recommendationId String
  actorUserId      String?
  previousStatus   RecommendationStatus?
  newStatus        RecommendationStatus?
  action           String
  reason           String?
  metadata         Json?
  recommendation   ProactiveRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  actor            User?                   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                @default(now())

  @@index([recommendationId, createdAt])
  @@index([actorUserId, createdAt])
}

model CitizenFeedback {
  id                  String       @id @default(cuid())
  incidentId          String
  citizenId           String?
  feedbackType        FeedbackType
  feedbackDescription String
  incident            Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  citizen             User?        @relation("CitizenFeedback", fields: [citizenId], references: [id], onDelete: SetNull)
  createdAt           DateTime     @default(now())
}

model IncidentSupport {
  id          String    @id @default(cuid())
  incidentId  String
  userId      String
  isActive    Boolean   @default(true)
  supportedAt DateTime  @default(now())
  withdrawnAt DateTime?
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([incidentId, userId])
  @@index([userId, isActive, supportedAt])
  @@index([incidentId, isActive, supportedAt])
}

model IncidentSupportEvent {
  id         String             @id @default(cuid())
  incidentId String
  userId     String
  action     SupportEventAction
  incident   Incident           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@index([incidentId, action, createdAt])
  @@index([userId, createdAt])
}

model FollowedArea {
  id              String   @id @default(cuid())
  userId          String
  name            String
  centerLatitude  Float
  centerLongitude Float
  radiusMeters    Int      @default(500)
  isActive        Boolean  @default(true)
  followedAt      DateTime @default(now())
  unfollowedAt    DateTime?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model CivicCampaign {
  id              String                @id @default(cuid())
  name            String
  description     String
  campaignType    CivicCampaignType
  objective       String
  startAt         DateTime
  endAt           DateTime
  targetAreaLabel String
  targetLatitude  Float?
  targetLongitude Float?
  radiusMeters    Int?
  departmentId    String?
  createdByUserId String
  status          CivicCampaignStatus   @default(DRAFT)
  department      Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creator         User                  @relation("CampaignCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  participants    CampaignParticipant[]
  incidentLinks   CampaignIncident[]
  auditEvents     CampaignAuditEvent[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, startAt, endAt])
  @@index([departmentId, status, startAt])
  @@index([createdByUserId, createdAt])
}

model CampaignParticipant {
  id         String        @id @default(cuid())
  campaignId String
  userId     String
  isActive   Boolean       @default(true)
  joinedAt   DateTime      @default(now())
  leftAt     DateTime?
  campaign   CivicCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events     CampaignParticipationEvent[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([campaignId, userId])
  @@index([userId, isActive, joinedAt])
  @@index([campaignId, isActive, joinedAt])
}

model CampaignParticipationEvent {
  id            String                      @id @default(cuid())
  participantId String
  action        CampaignParticipationAction
  participant   CampaignParticipant         @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdAt     DateTime                    @default(now())

  @@index([participantId, createdAt])
}

model CampaignIncident {
  id             String        @id @default(cuid())
  campaignId     String
  incidentId     String
  linkedByUserId String?
  campaign       CivicCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  incident       Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  linkedBy       User?         @relation("CampaignIncidentLinker", fields: [linkedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@unique([campaignId, incidentId])
  @@index([incidentId, createdAt])
  @@index([campaignId, createdAt])
}

model CampaignAuditEvent {
  id          String               @id @default(cuid())
  campaignId  String
  actorUserId String?
  action      CampaignAuditAction
  fromStatus  CivicCampaignStatus?
  toStatus    CivicCampaignStatus?
  metadata    Json?
  campaign    CivicCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actor       User?                @relation("CampaignAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())

  @@index([campaignId, createdAt])
  @@index([actorUserId, createdAt])
}

model CivicNotification {
  id          String                @id @default(cuid())
  recipientId String
  type        CivicNotificationType
  title       String
  message     String
  entityType  String
  entityId    String
  sourceKey   String                @unique
  readAt      DateTime?
  recipient   User                  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())

  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  targetType String
  targetId   String
  metadata   Json?
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
}

model AiConsentGrant {
  id          String    @id @default(cuid())
  tokenId     String    @unique
  userId      String
  purpose     String
  operation   String
  subjectHash String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt, consumedAt])
}
