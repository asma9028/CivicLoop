# Copy to server/.env for local development
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicloop"
# Required for auth. Generate a unique secret for each environment; never deploy this file's blank value.
JWT_SECRET=""
NODE_ENV="development"

# Development-only bootstrap. Never enable in production.
BOOTSTRAP_ADMIN_ENABLED="false"
BOOTSTRAP_ADMIN_EMAIL="admin@example.demo"
BOOTSTRAP_ADMIN_PASSWORD=""

# Optional AI classification. Rule-based analysis is used when unset/unavailable.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
INCIDENT_DUPLICATE_RADIUS_METERS="300"
INCIDENT_DUPLICATE_WINDOW_DAYS="30"
AUTHORITY_OVERDUE_HOURS="72"
AUTHORITY_UNACKNOWLEDGED_HOURS="24"
VERIFICATION_RESPONSE_HOURS="72"
VERIFICATION_DISPUTE_ESCALATION_HOURS="48"
VERIFICATION_REVIEW_OVERDUE_HOURS="72"

# City intelligence uses deterministic geographic clusters and documented weights.
INTELLIGENCE_HOTSPOT_RADIUS_METERS="500"
INTELLIGENCE_HOTSPOT_MIN_INCIDENTS="3"
INTELLIGENCE_PUBLIC_HOTSPOT_MIN_INCIDENTS="5"
INTELLIGENCE_RECURRENCE_RADIUS_METERS="250"
INTELLIGENCE_RECURRENCE_WINDOW_DAYS="365"
INTELLIGENCE_OVERDUE_HOURS="72"
INTELLIGENCE_RISK_WEIGHT_DENSITY="30"
INTELLIGENCE_RISK_WEIGHT_SEVERITY="25"
INTELLIGENCE_RISK_WEIGHT_RECURRENCE="20"
INTELLIGENCE_RISK_WEIGHT_OVERDUE="15"
INTELLIGENCE_RISK_WEIGHT_DISPUTE_REOPEN="10"
